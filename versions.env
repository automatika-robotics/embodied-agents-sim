# Pinned versions for the sim stack, sourced by setup.sh, doctor.sh and the
# Makefile. See "Version pins and patches" in the README before changing any.

# Python interpreters
PY_ISAAC=3.11          # Isaac Sim 5.1 wheels are cp311
PY_LEROBOT=3.12        # lerobot >= 0.5 requires 3.12

# Core packages
ISAACSIM_PIP_SPEC="isaacsim[all,extscache]==5.1.0.0"
ISAACSIM_INDEX_URL="https://pypi.nvidia.com"
ISAACLAB_REPO="https://github.com/isaac-sim/IsaacLab.git"
ISAACLAB_TAG="v2.3.0"
LEROBOT_PIP_SPEC="lerobot[async,groot,smolvla]==0.6.1"
LEISAAC_REPO="https://github.com/LightwheelAI/leisaac.git"
LEISAAC_COMMIT="24d3bcd3f1e4585740fc79921782c41617237812"

# Installed before IsaacLab so its installer finds the pin met and skips it
TORCH_INDEX_URL="https://download.pytorch.org/whl/cu128"
TORCH_PIP_SPEC="torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0"

# Scene assets (LeIsaac kitchen-with-orange release)
ASSETS_SCENE_URL="https://github.com/LightwheelAI/leisaac/releases/download/v0.1.0/kitchen_with_orange.zip"
ASSETS_ROBOT_URL="https://github.com/LightwheelAI/leisaac/releases/download/v0.1.0/so101_follower.usd"

# Matched eval triple
DATASET_REPO="LightwheelAI/leisaac-pick-orange"
DEFAULT_CHECKPOINT="aleph-ra/gr00t17_pick_orange_lora"
TASK_STRING="Grab orange and place into plate"   # the dataset's exact wording

# git-lfs, needed by the IsaacLab clone, installed standalone if missing
GIT_LFS_URL="https://github.com/git-lfs/git-lfs/releases/download/v3.7.0/git-lfs-linux-amd64-v3.7.0.tar.gz"
